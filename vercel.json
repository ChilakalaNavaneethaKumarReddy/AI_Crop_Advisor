{
  "version": 2,
  "builds": [
    {
      "src": "project-fai/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "project-fai/templates/**",
          "project-fai/static/**",
          "project-fai/models/class_names.json",
          "project-fai/models/crop_disease_model.tflite"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "project-fai/app.py"
    }
  ]
}
